{% if settings.goEnable %}
<div class="gokwik-checkout"{% if settings.hideFlow %} style="display:none !important;" {% endif %}>
 <button type='button' class="button disabled" disabled onclick="onCheckoutNow(this)">
   <span class="btn-text">
     <span>{{ settings.main-titile }}</span>
     <span>{{ settings.sub-titile }}</span>
   </span>
   <span class="pay-opt-icon">
     {% if settings.enableLogo %}
       <img src="https://cdn.gokwik.co/v4/images/upi-icons.svg">
     <img src="https://cdn.gokwik.co/v4/images/right-arrow.svg">
      {% endif %}
   </span>
   <div style="display:none" class="addloadr" id="btn-loader">
     <div class="cir-loader">Loading..</div>
   </div>
 </button>
</div>
{% unless settings.hideFlow %}
{% comment %} Hide Shopify express checkout buttons (Shop Pay, GPay etc.) next to GoKwik: they bypass GoKwik checkout. Added 3 Nov 2026. {% endcomment %}
<style>
  .cart__ctas .additional-checkout-buttons { display: none !important; }
</style>
{% endunless %}
{% endif %}